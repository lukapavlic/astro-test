---
import {t,type Lang} from '../lib/site';
const {lang}=Astro.props as {lang:Lang};
const steps=lang==='en'?[['Research','Ask a useful question.'],['Experiments','Test under defined conditions.'],['Patterns & evidence','Find what can be repeated.'],['Pilots','Learn in real environments.'],['Good practices','Bring the knowledge to work.']]:[['Raziskovanje','Zastavimo koristno vprašanje.'],['Eksperimenti','Preverimo v določenih razmerah.'],['Vzorci in dokazi','Poiščemo, kaj je ponovljivo.'],['Piloti','Učimo se v resničnih okoljih.'],['Dobre prakse','Znanje prenesemo v delo.']];
---
<section class="practice-section section">
  <div class="container">
    <div class="practice-intro"><span class="eyebrow">{t(lang,'Our approach','Naš pristop')}</span><h2>{t(lang,'From a good question.','Od dobrega vprašanja.')}<br/><span>{t(lang,'To a better practice.','Do boljše prakse.')}</span></h2><p>{t(lang,'Systematic. Measurable. Reusable. Research becomes useful when we can explain how, where and why an approach works.','Sistematično. Merljivo. Ponovno uporabljivo. Raziskovanje postane uporabno, ko lahko pojasnimo, kako, kje in zakaj pristop deluje.')}</p></div>
    <ol class="practice-flow">{steps.map(([title,description],i)=><li style={`--step:${i}`}><div class="step-top"><span class="step-number">0{i+1}</span><span aria-hidden="true">{i===4?'↗':'→'}</span></div><h3>{title}</h3><p>{description}</p><div class="step-baseline" aria-hidden="true"></div></li>)}</ol>
  </div>
</section>
<style>
.practice-section{background:var(--color-soft);border-block:1px solid var(--color-line)}.practice-intro{display:grid;grid-template-columns:.7fr 1.3fr 1fr;gap:2.5rem;align-items:start;margin-bottom:3.5rem}.practice-intro .eyebrow{padding-top:.5rem;color:var(--color-brand)}.practice-intro h2{font-size:clamp(1.8rem,2.5vw,2.5rem)}.practice-intro h2 span{color:var(--color-brand)}.practice-intro>p{font-size:.87rem;color:var(--color-muted);max-width:37ch}.practice-flow{display:grid;grid-template-columns:repeat(5,1fr);margin:0;padding:0;gap:0;list-style:none}.practice-flow li{padding:1.2rem 1.3rem 0;border-left:1px solid var(--color-line);display:flex;flex-direction:column;min-height:200px}.practice-flow li:first-child{padding-left:0;border:0}.step-top{display:flex;justify-content:space-between;align-items:center;color:var(--color-brand)}.step-number{font-size:.7rem;font-weight:700}.practice-flow h3{font-size:1.05rem;margin:1.5rem 0 .6rem}.practice-flow p{font-size:.75rem;color:var(--color-muted);margin-bottom:2rem}.step-baseline{height:calc(8px + var(--step) * 9px);width:100%;background:var(--color-brand);opacity:calc(.22 + var(--step) * .18);margin-top:auto}.practice-flow li:last-child{background:var(--color-brand-soft)}
@media(max-width:900px){.practice-intro{grid-template-columns:1fr 1fr}.practice-intro>.eyebrow{grid-column:1/-1}.practice-flow li{padding:1rem .7rem 0}.practice-flow h3{font-size:.9rem}}
@media(max-width:640px){.practice-intro{grid-template-columns:1fr;gap:1.2rem}.practice-flow{grid-template-columns:1fr}.practice-flow li,.practice-flow li:first-child{min-height:0;display:grid;grid-template-columns:35px 1fr;gap:.4rem 1rem;padding:1.3rem 1rem;border:0;border-top:1px solid var(--color-line)}.step-top{align-items:start}.step-top>span:last-child{display:none}.practice-flow h3{margin:0;font-size:1.1rem}.practice-flow p{grid-column:2;margin:0}.step-baseline{grid-column:2;height:4px;width:calc(30% + var(--step) * 17%);margin-top:.5rem}}
</style>
