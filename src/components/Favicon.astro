---
import { asset } from '../lib/site';
const version = 'olive-eight-nodes-20261106';
const icon = (path: string) => `${asset(path)}?v=${version}`;
---
<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={icon('favicon.ico')} />
<link rel="icon" type="image/png" sizes="32x32" href={icon('branding/favicon-recoloured-32.png')} />
<link rel="icon" type="image/png" sizes="192x192" href={icon('branding/favicon-recoloured-192.png')} />
<link rel="apple-touch-icon" sizes="180x180" href={icon('apple-touch-icon.png')} />
