---
import { href, navigation, t, type Lang } from '../lib/site';
const {lang,path=''} = Astro.props as {lang:Lang;path?:string};
---
<footer>
  <div class="container footer-top">
    <div class="footer-identity"><a class="footer-logo" href={href(lang)}>agentic<span class="footer-logo-light">lab</span><span class="footer-logo-dot">.</span></a><p>{t(lang,'Software engineering. With evidence.','Programsko inženirstvo. Z dokazi.')}</p><a class="text-link" href="mailto:luka.pavlic@um.si">agentic.lab@um.si <span aria-hidden="true">↗</span></a></div>
    <div class="footer-institution"><span class="eyebrow">{t(lang,'Rooted in research','Raziskovalna podlaga')}</span><p><a href="https://ii.feri.um.si/sl/">{t(lang,'Information Systems Laboratory (LIS)','Laboratorij za informacijske sisteme (LIS)')}</a><br/><a href="https://ii.feri.um.si/sl/">{t(lang,'Institute of Informatics','Inštitut za informatiko')}</a><br/><a href="https://feri.um.si/">{t(lang,'Faculty of Electrical Engineering and Computer Science','Fakulteta za elektrotehniko, računalništvo in informatiko')}</a></p><a href="https://www.um.si/">{t(lang,'University of Maribor','Univerza v Mariboru')} ↗</a></div>
    <nav aria-label={t(lang,'Footer navigation','Navigacija v nogi')}>{navigation[lang].map(([slug,label])=><a href={href(lang,slug)}>{label}</a>)}</nav>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} Agentic Lab</span><span>Maribor, {t(lang,'Slovenia','Slovenija')}</span><div><a href={href('sl',path)} lang="sl" aria-current={lang==='sl'?'true':undefined}>SL</a><span aria-hidden="true"> / </span><a href={href('en',path)} lang="en" aria-current={lang==='en'?'true':undefined}>EN</a></div><a href="https://ii.feri.um.si/sl/">{t(lang,'Institute of Informatics','Inštitut za informatiko')} ↗</a></div>
</footer>
<style>
footer{border-top:1px solid var(--color-line);padding-top:4rem}.footer-top{display:grid;grid-template-columns:1.2fr 1.3fr .7fr;gap:3rem;padding-bottom:3rem}.footer-logo{font-size:1.8rem;font-weight:750;letter-spacing:-.08em;text-decoration:none;line-height:1}.footer-logo-light{font-weight:450}.footer-logo-dot{color:var(--color-brand)}.footer-identity p{font-size:.77rem;color:var(--color-muted);margin:1rem 0}.footer-identity .text-link{font-size:.75rem}.footer-institution .eyebrow{font-size:.6rem;margin-bottom:1rem;color:var(--color-muted)}.footer-institution p{font-size:.75rem;line-height:1.85}.footer-institution>a{font-size:.75rem;color:var(--color-brand);display:block;margin-top:.6rem;text-decoration:none}.footer-top nav{display:flex;flex-direction:column;gap:.4rem}.footer-top nav a{font-size:.75rem;text-decoration:none}.footer-top nav a:hover{text-decoration:underline}.footer-bottom{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--color-line);padding-block:1.2rem;font-size:.63rem;color:var(--color-muted)}.footer-bottom a{text-decoration:none}.footer-bottom [aria-current]{color:var(--color-text);font-weight:800}
@media(max-width:800px){.footer-top{grid-template-columns:1fr 1fr}.footer-top nav{grid-column:1/-1;flex-direction:row;flex-wrap:wrap;gap:1rem 2rem}.footer-bottom{flex-wrap:wrap}.footer-bottom>a{width:100%}}
@media(max-width:500px){.footer-top{grid-template-columns:1fr;gap:2rem}}
</style>
