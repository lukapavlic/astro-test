---
import type {CollectionEntry} from 'astro:content';
import {href,t,eventDateLabel,eventType,isUpcoming,type Lang} from '../lib/site';
const {event,lang}=Astro.props as {event:CollectionEntry<'events'>;lang:Lang};
const e=event.data;
const upcoming=isUpcoming(event);
const day=new Intl.DateTimeFormat('en-GB',{day:'2-digit',timeZone:'Europe/Ljubljana'}).format(new Date(e.date));
---
<article class="event-feature">
  <div class="event-date"><span class="eyebrow">{upcoming?t(lang,'Open to curious minds','Odprto za radovedne'):t(lang,'Past event','Pretekli dogodek')}</span><span class="date-number" aria-hidden="true">{day}<span>.</span></span><span class="date-month">{new Intl.DateTimeFormat(lang==='sl'?'sl-SI':'en-GB',{month:'long',year:'numeric',timeZone:'Europe/Ljubljana'}).format(new Date(e.date))}</span><span class="date-footer">{eventType(e.eventType,lang)}</span></div>
  <div class="event-info"><div class="event-kicker"><span class="eyebrow">{e.conference||(upcoming?t(lang,'On the calendar','Na koledarju'):t(lang,'From the archive','Iz arhiva'))}</span>{e.demo && <span class="demo-note">{t(lang,'Fictional demo event','Izmišljen demo dogodek')}</span>}</div><h2><a href={href(lang,`events/${e.key}`)}>{e.title}</a></h2><p>{e.shortDescription}</p><div class="event-details"><time datetime={e.date}>{eventDateLabel(e,lang)}</time><span>{e.price}</span><span>{e.location}</span></div><div class="event-actions">{upcoming&&e.registrationUrl&&<a class="button primary" href={e.registrationUrl}>{t(lang,'Register for the event','Prijava na dogodek')}<span aria-hidden="true">↗</span></a>}<a class="text-link" href={href(lang,`events/${e.key}`)}>{t(lang,'Explore the event','Več o dogodku')}<span aria-hidden="true">↗</span></a></div></div>
</article>
<style>
.event-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.5rem}.event-feature{display:grid;grid-template-columns:1fr 1.65fr;border:1px solid var(--color-line);border-radius:var(--radius);overflow:hidden}.event-date{background:var(--color-highlight);color:#2b3d22;display:flex;flex-direction:column;align-items:start;padding:2.4rem}.event-date .eyebrow{font-size:.6rem}.date-number{font-size:6.7rem;font-weight:500;letter-spacing:-.09em;line-height:1.1;margin-top:1.3rem}.date-number>span{color:#5a713c}.date-month{font-size:1.2rem;font-weight:600;letter-spacing:-.025em}.date-footer{margin-top:auto;padding-top:2rem;font-size:.68rem;border-top:1px solid #829464;width:100%}.event-info{padding:2.5rem 3rem;background:var(--color-surface)}.event-kicker{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-bottom:1.6rem}.event-kicker .eyebrow{color:var(--color-muted);font-size:.65rem}.event-info h2{font-size:clamp(1.7rem,2.4vw,2.4rem);max-width:24ch}.event-info h2 a{text-decoration:none}.event-info>p{font-size:.9rem;color:var(--color-muted);margin-top:1.2rem}.event-details{display:flex;gap:.5rem 1rem;flex-wrap:wrap;font-size:.72rem;margin-block:1.5rem}.event-details>span:last-child{width:100%;color:var(--color-muted)}.event-details>span:nth-child(2){color:var(--color-quality);font-weight:750}
@media(max-width:800px){.event-info{padding:2rem}.event-date{padding:2rem 1.5rem}.date-number{font-size:5rem}}
@media(max-width:600px){.event-feature{grid-template-columns:1fr}.event-date{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:.5rem;padding:1.5rem}.event-date .eyebrow{grid-column:1/-1}.date-number{grid-row:2/4;margin:0;font-size:4.6rem}.date-month{font-size:1rem}.date-footer{padding:.5rem 0 0;font-size:.6rem}.event-info{padding:1.5rem}}
</style>
