---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PersonCard from '../../components/PersonCard.astro';
import ReferenceRow from '../../components/ReferenceRow.astro';
import ResearchToPractice from '../../components/ResearchToPractice.astro';
import EventFeature from '../../components/EventFeature.astro';
import CTA from '../../components/CTA.astro';
import {collection,languages,href,t,isUpcoming,type Lang} from '../../lib/site';
export function getStaticPaths(){return languages.flatMap(lang=>['research','references','events','people','industry','about'].map(page=>({params:{lang,page}})));}
const lang=Astro.params.lang as Lang;
const key=Astro.params.page!;
const [pages,research,references,events,people,services]=await Promise.all([collection('pages',lang),collection('research',lang),collection('references',lang),collection('events',lang),collection('people',lang),collection('services',lang)]);
const page=pages.find(p=>p.data.key===key)!;
const {Content}=await render(page);
const upcoming=events.filter(e=>isUpcoming(e)).sort((a,b)=>Date.parse(a.data.date)-Date.parse(b.data.date));
const past=events.filter(e=>!isUpcoming(e)).sort((a,b)=>Date.parse(b.data.date)-Date.parse(a.data.date));
const serviceContent=await Promise.all(services.map(async s=>({service:s,...await render(s)})));
const filters=lang==='en'?[['all','All'],['research','Research'],['publications','Publications'],['experiments','Experiments'],['tools','Prototypes & Tools'],['methods','Methods & Patterns']]:[['all','Vse'],['research','Raziskave'],['publications','Objave'],['experiments','Eksperimenti'],['tools','Prototipi in orodja'],['methods','Metode in vzorci']];
const names:Record<string,string>={research:t(lang,'Research','Raziskovanje'),references:t(lang,'References','Reference'),events:t(lang,'Events','Dogodki'),people:t(lang,'People','Ljudje'),industry:t(lang,'Industry Collaboration','Sodelovanje z industrijo'),about:t(lang,'About','O nas')};
---
<Layout lang={lang} title={names[key]} description={page.data.shortDescription} path={key}>
  <section class="page-intro"><div class="container"><span class="eyebrow">AGENTIC LAB / {names[key]}</span><h1>{page.data.title}</h1><p>{page.data.shortDescription}</p></div></section>
  {key==='research' && <>
    <section class="section container"><div class="section-heading"><div><span class="eyebrow">01 / {t(lang,'Research focus','Raziskovalna področja')}</span><h2>{t(lang,'Connected fields of inquiry.','Povezana področja raziskovanja.')}</h2></div></div><div class="research-areas">{research.map((r,i)=><article class="research-full" data-accent={r.data.accent}><span class="research-number">0{i+1}</span><div><h3><a href={href(lang,`research/${r.data.key}`)}>{r.data.title} <span aria-hidden="true">↗</span></a></h3><p>{r.data.shortDescription}</p><div class="tags">{r.data.topics.map(tag=><span class="tag">{tag}</span>)}</div></div></article>)}</div></section>
    <ResearchToPractice lang={lang}/><section class="section container split-content"><aside class="side-note"><span class="eyebrow">02 / {t(lang,'Research activities','Raziskovalne aktivnosti')}</span><p class="mt-5">{t(lang,'We study the engineering system around the agent.','Preučujemo inženirski sistem, v katerem deluje agent.')}</p></aside><div class="prose"><Content/></div></section>
  </>}
  {key==='references' && <section class="section container"><h2 class="mb-6">{t(lang,'Research directions & results','Raziskovalne smeri in rezultati')}</h2><p class="reference-explainer">{t(lang,'Research entries describe topics under investigation. Scientific publications link to their source and verified bibliographic details.','Raziskovalni zapisi opisujejo teme, ki jih preučujemo. Znanstvene objave vključujejo vir in preverjene bibliografske podatke.')}</p><div class="filter-bar" data-filters hidden role="group" aria-label={t(lang,'Filter references by type','Filtriranje referenc po vrsti')}>{filters.map(([value,label])=><button type="button" data-filter={value} aria-pressed={value==='all'?'true':'false'}>{label}</button>)}</div><p class="sr-only" data-filter-count aria-live="polite" data-en={lang==='en'}></p><div class="reference-list">{references.map(reference=><ReferenceRow reference={reference} lang={lang}/>)}</div></section>}
  {key==='events' && <section class="section container"><div class="section-heading"><div><span class="eyebrow">{t(lang,'Coming up','Prihaja')}</span><h2>{t(lang,'Upcoming events','Prihodnji dogodki')}</h2></div></div>{upcoming.length?upcoming.map(event=><div class="mb-8"><EventFeature event={event} lang={lang}/></div>):<p class="muted">{t(lang,'No upcoming events are currently announced.','Trenutno ni napovedanih prihodnjih dogodkov.')}</p>}<div class="past-events" id="past-events"><h2>{t(lang,'Past events','Pretekli dogodki')}</h2>{past.length?past.map(event=><div class="mt-8"><EventFeature event={event} lang={lang}/></div>):<p class="muted mt-5">{t(lang,'The archive will grow as events take place.','Arhiv bomo dopolnjevali z izvedenimi dogodki.')}</p>}</div></section>}
  {key==='people' && <><section class="section container"><div class="section-heading"><div><span class="eyebrow">01 / {t(lang,'Core team','Osrednja ekipa')}</span><h2>{t(lang,'People who connect the dots.','Ljudje, ki povezujejo znanje.')}</h2></div></div><div class="people-grid">{people.filter(p=>p.data.memberType==='core').map(person=><PersonCard person={person} lang={lang}/>)}</div></section><section class="collaborators section"><div class="container"><div class="section-heading"><div><span class="eyebrow">02 / {t(lang,'Our network','Naša mreža')}</span><h2>{t(lang,'External Collaborators','Zunanji sodelavci')}</h2></div></div><div class="collaborator-grid">{people.filter(p=>p.data.memberType==='collaborator').map(person=><PersonCard person={person} lang={lang} compact/>)}</div></div></section></>}
  {key==='industry' && <><section class="section container"><div class="section-heading"><h2>{t(lang,'Ways to collaborate','Oblike sodelovanja')}</h2></div><div class="service-list">{serviceContent.map(({service:s,Content},i)=><article class="service-item" id={s.data.key}><span class="number">0{i+1}</span><div><h3>{s.data.title}</h3><p>{s.data.shortDescription}</p></div><div class="prose"><Content/></div></article>)}</div></section><section class="container split-content"><aside class="side-note"><span class="eyebrow">{t(lang,'A shared starting point','Skupno izhodišče')}</span></aside><div class="prose"><Content/></div></section><section class="section container"><CTA lang={lang}/><a class="text-link mt-6" href={href(lang,'research')}>{t(lang,'Explore our research','Naše raziskovanje')} ↗</a></section></>}
  {key==='about' && <><section class="section container split-content"><aside><div class="institution-stack"><span>AGENTIC LAB</span><span>{t(lang,'Information Systems Laboratory','Laboratorij za informacijske sisteme')}<b>LIS</b></span><span>{t(lang,'Institute of Informatics','Inštitut za informatiko')}</span><span>UM FERI</span><a href="https://www.um.si/">{t(lang,'University of Maribor','Univerza v Mariboru')} ↗</a></div><div class="side-note mt-8"><strong>Luka Pavlič</strong>{t(lang,'Head of Agentic Lab','Vodja Agentic Lab')}<br/>{t(lang,'Head of Information Systems Laboratory','Vodja Laboratorija za informacijske sisteme')}<a class="text-link mt-4" href={href(lang,'people/luka-pavlic')}>{t(lang,'Profile & contact','Profil in kontakt')} ↗</a></div></aside><div class="prose"><Content/></div></section><section class="lifecycle-section section"><div class="container"><span class="eyebrow">{t(lang,'The whole lifecycle','Celoten življenjski cikel')}</span><h2 class="mt-5">{t(lang,'Every stage is an engineering question.','Vsaka faza je inženirsko vprašanje.')}</h2><p class="muted mt-5">{t(lang,'We investigate how AI agents can participate effectively and responsibly throughout the life of a software or information system.','Raziskujemo, kako lahko agenti UI učinkovito in odgovorno sodelujejo skozi celoten življenjski cikel programskega ali informacijskega sistema.')}</p><ol class="lifecycle">{(lang==='en'?['Idea','Requirements','Architecture','Implementation','Testing','Deployment','Operation','Evolution']:['Ideja','Zahteve','Arhitektura','Implementacija','Testiranje','Nameščanje','Delovanje','Nadaljnji razvoj']).map(label=><li>{label}</li>)}</ol></div></section><section class="section container"><CTA lang={lang}/></section></>}
</Layout>
<script>
const filters=document.querySelector<HTMLElement>('[data-filters]');
if(filters){filters.hidden=false;const entries=[...document.querySelectorAll<HTMLElement>('[data-reference]')];filters.addEventListener('click',event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');if(!button)return;const selected=button.dataset.filter;filters.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));let count=0;entries.forEach(entry=>{entry.hidden=selected!=='all'&&entry.dataset.group!==selected;if(!entry.hidden)count++;});const status=document.querySelector<HTMLElement>('[data-filter-count]');if(status)status.textContent=status.dataset.en==='true'?`${count} references shown`:`Prikazanih referenc: ${count}`;});}
</script>
<style>
.research-areas{border-top:1px solid var(--color-line)}.research-full{display:grid;grid-template-columns:90px 1fr;gap:2rem;padding:2.5rem 0;border-bottom:1px solid var(--color-line)}.research-number{font-size:2rem;line-height:1.2;letter-spacing:-.06em;color:var(--accent)}.research-full h3{font-size:1.5rem}.research-full h3 a{text-decoration:none}.research-full h3 span{color:var(--accent);font-size:1.2rem;margin-left:.4rem}.research-full p{color:var(--color-muted);margin-top:1rem;max-width:75ch;font-size:.95rem}.research-full .tags{margin-top:1.2rem}.reference-explainer{font-size:.85rem;color:var(--color-muted);max-width:80ch;margin-bottom:2rem}.past-events{margin-top:4rem;padding-top:3rem;border-top:1px solid var(--color-line)}.collaborators{background:var(--color-soft)}.institution-stack{display:flex;flex-direction:column;border:1px solid var(--color-line);border-radius:var(--radius);overflow:hidden}.institution-stack>span,.institution-stack>a{padding:1rem 1.2rem;border-bottom:1px solid var(--color-line);font-size:.78rem;line-height:1.6}.institution-stack>span:first-child{background:var(--color-brand-soft);color:var(--color-brand);font-weight:750;letter-spacing:.08em}.institution-stack b{display:block;font-size:1.3rem;margin-top:.3rem}.institution-stack>a{border:0;color:var(--color-brand);text-decoration:none}.lifecycle-section{background:var(--color-soft);border-block:1px solid var(--color-line)}.lifecycle-section h2{max-width:27ch}.lifecycle-section p{max-width:70ch}
@media(max-width:640px){.research-full{grid-template-columns:35px 1fr;gap:1rem}.research-number{font-size:1.3rem}.research-full h3{font-size:1.2rem}.research-full .tag{font-size:.65rem}}
</style>
