---
import Layout from '../../layouts/Layout.astro';
import PersonCard from '../../components/PersonCard.astro';
import ReferenceRow from '../../components/ReferenceRow.astro';
import ResearchToPractice from '../../components/ResearchToPractice.astro';
import EventFeature from '../../components/EventFeature.astro';
import { collection, languages, href, t, isUpcoming, type Lang } from '../../lib/site';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
const [pages,research,references,events,people,services]=await Promise.all([collection('pages',lang),collection('research',lang),collection('references',lang),collection('events',lang),collection('people',lang),collection('services',lang)]);
const page=pages.find(p=>p.data.key==='home')!;
const event=events.filter(e=>isUpcoming(e)).sort((a,b)=>Date.parse(a.data.date)-Date.parse(b.data.date))[0];
const core=people.filter(p=>p.data.memberType==='core').slice(0,4);
const shortNames=lang==='en'?['Agentic Software Engineering','AI for Software Engineering','Software Quality & Analytics','DevOps / DevSecOps','Modern Software Architectures','UX & Accessibility']:['Agentno programsko inženirstvo','UI za programsko inženirstvo','Kakovost in inženirska analitika','DevOps / DevSecOps','Sodobne arhitekture','UX in dostopnost'];
---
<Layout lang={lang} title={page.data.title} description={page.data.shortDescription}>
  <section class="hero container">
    <div class="hero-copy"><div class="hero-label"><span class="eyebrow">AGENTIC LAB</span><span class="hero-pill">{t(lang,'Research · Education · Industry','Raziskovanje · Izobraževanje · Industrija')}</span></div><h1>{t(lang,'Building software','Gradimo programsko opremo')}<br/><span>{t(lang,'with AI agents.','z agenti UI.')}</span></h1><p class="hero-description">{page.data.shortDescription}</p><div class="actions"><a class="button primary" href={href(lang,'research')}>{t(lang,'Explore our research','Naše raziskovanje')}<span aria-hidden="true">↗</span></a><a class="button" href={href(lang,'industry')}>{t(lang,'Work with us','Sodelujte z nami')}<span aria-hidden="true">↗</span></a></div></div>
    <div class="engineering-note" role="img" aria-label={t(lang,'An engineering workflow: human intent becomes explicit context, coordinated agent work and verified software.','Inženirski potek: človeški namen postane jasen kontekst, usklajeno delo agentov in preverjena programska oprema.')}>
      <div class="note-top"><span>AGENTIC LAB / {t(lang,'FIELD NOTES','RAZISKOVALNI ZAPISKI')}</span><span>01—06</span></div>
      <div class="note-heading">{t(lang,'Autonomy needs','Avtonomija potrebuje')}<br/><em>{t(lang,'engineering.','inženirstvo.')}</em></div>
      <div class="artifact-stack">
        <div class="artifact" data-accent="agentic"><span class="artifact-index">01</span><div><strong>{t(lang,'Intent → context','Namen → kontekst')}</strong><small>AGENTS.md &nbsp; / &nbsp; SPEC.md</small></div><span class="artifact-end" aria-hidden="true">↘</span></div>
        <div class="artifact" data-accent="ai4se"><span class="artifact-index">02</span><div><strong>{t(lang,'Plan → agent work','Načrt → delo agentov')}</strong><small>{t(lang,'ORCHESTRATE / IMPLEMENT','ORKESTRACIJA / IZVEDBA')}</small></div><span class="artifact-end" aria-hidden="true">↘</span></div>
        <div class="artifact" data-accent="quality"><span class="artifact-index">03</span><div><strong>{t(lang,'Verify → improve','Preverjanje → izboljšave')}</strong><small>{t(lang,'TEST / REVIEW / MEASURE','TEST / PREGLED / MERITVE')}</small></div><span class="artifact-end" aria-hidden="true">✓</span></div>
      </div>
      <div class="note-bottom"><span>{t(lang,'Human judgement. At every layer.','Človeška presoja. Na vsaki ravni.')}</span><span aria-hidden="true">↗</span></div>
    </div>
  </section>
  <section class="section container research-preview">
    <div class="section-heading"><div><span class="eyebrow">01 / {t(lang,'Research focus','Raziskovalna področja')}</span><h2>{t(lang,'Six perspectives.','Šest pogledov.')}<br/>{t(lang,'One engineering mindset.','Ena inženirska miselnost.')}</h2></div><a class="text-link" href={href(lang,'research')}>{t(lang,'Explore our research','Naše raziskovanje')} <span aria-hidden="true">↗</span></a></div>
    <div class="research-composition">{research.map((r,i)=><article class:list={['focus-item',i<2?'focus-primary':'focus-secondary']} data-accent={r.data.accent}><div class="focus-top"><span>0{i+1} / {i===1?'AI4SE':t(lang,'RESEARCH','RAZISKOVANJE')}</span><span aria-hidden="true">↗</span></div><h3><a href={href(lang,`research/${r.data.key}`)}>{shortNames[i]}</a></h3><p>{r.data.shortDescription}</p>{i<2&&<div class="tags">{r.data.topics.slice(0,3).map(tag=><span class="tag">{tag}</span>)}</div>}</article>)}</div>
  </section>
  <ResearchToPractice lang={lang}/>
  <section class="section container">
    <div class="section-heading"><div><span class="eyebrow">02 / {t(lang,'Selected references','Izbrane reference')}</span><h2>{t(lang,'Questions we put to work.','Vprašanja, ki jih raziskujemo.')}</h2></div><a class="text-link" href={href(lang,'references')}>{t(lang,'All references','Vse reference')} <span aria-hidden="true">↗</span></a></div>
    <div class="reference-list">{references.filter(r=>r.data.featured).map(reference=><ReferenceRow reference={reference} lang={lang}/>)}</div>
  </section>
  {event && <section class="container event-section"><EventFeature event={event} lang={lang}/></section>}
  <section class="section container industry-preview">
    <div class="industry-heading"><span class="eyebrow">03 / {t(lang,'Industry collaboration','Sodelovanje z industrijo')}</span><h2>{t(lang,'Real environments.','Resnična okolja.')}<br/><span>{t(lang,'Useful questions.','Koristna vprašanja.')}</span></h2><p>{t(lang,'Where research meets the realities of software teams. Let’s explore what agentic engineering could mean in your context.','Kjer se raziskovanje sreča z resničnostjo razvojnih ekip. Raziščimo, kaj bi agentno inženirstvo lahko pomenilo v vašem okolju.')}</p><a class="button primary" href={href(lang,'industry')}>{t(lang,'Work with us','Sodelujte z nami')} <span aria-hidden="true">↗</span></a></div>
    <div class="industry-options">{services.filter(s=>s.data.key!=='architecture').map((s,i)=><a href={href(lang,`industry#${s.data.key}`)}><span class="option-number">0{i+1}</span><div><h3>{s.data.title}</h3><p>{s.data.shortDescription}</p></div><span aria-hidden="true">↗</span></a>)}</div>
  </section>
  <section class="people-preview section"><div class="container"><div class="section-heading"><div><span class="eyebrow">04 / {t(lang,'The people behind the questions','Ljudje za raziskovalnimi vprašanji')}</span><h2>{t(lang,'Research is a team effort.','Raziskovanje je skupinsko delo.')}</h2></div><a class="text-link" href={href(lang,'people')}>{t(lang,'Meet the whole team','Spoznajte celotno ekipo')} <span aria-hidden="true">↗</span></a></div><div class="people-grid">{core.map(person=><PersonCard person={person} lang={lang} compact/>)}</div></div></section>
</Layout>
<style>
.hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:3rem 4rem;padding-top:4.5rem}.hero>*{min-width:0}.hero-label{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.7rem}.hero-label .eyebrow{color:var(--color-brand)}.hero-pill{font-size:.58rem;color:var(--color-muted);border:1px solid var(--color-line);border-radius:20px;padding:.25rem .6rem;font-weight:650}.hero h1{font-size:clamp(2.7rem,4.7vw,4.1rem);line-height:1.13;letter-spacing:-.055em;max-width:15ch}.hero h1 span{color:var(--color-brand)}.hero-description{font-size:1rem;line-height:1.8;color:var(--color-muted);max-width:56ch;margin:1.5rem 0 1.9rem}.hero .actions .button{font-size:.73rem}.hero-copy{padding-block:.5rem 1rem}
.engineering-note{align-self:start;background:var(--color-soft);padding:1.5rem 1.7rem;border-radius:var(--radius);border:1px solid var(--color-line);transform:rotate(1.5deg);margin-top:.5rem}.note-top{display:flex;justify-content:space-between;font-size:.5rem;letter-spacing:.12em;color:var(--color-muted);padding-bottom:1rem;border-bottom:1px solid var(--color-line);font-weight:750}.note-heading{font-size:clamp(1.4rem,2.5vw,2rem);font-weight:550;letter-spacing:-.04em;line-height:1.2;margin:1.4rem 0}.note-heading em{font-style:normal;color:var(--color-brand)}.artifact-stack{display:flex;flex-direction:column;gap:.6rem}.artifact{display:flex;gap:.9rem;align-items:center;padding:.95rem 1rem;background:var(--accent-soft);color:var(--accent);border:1px solid color-mix(in srgb,var(--accent) 18%,transparent);border-left:3px solid var(--accent);border-radius:2px}.artifact:nth-child(2){margin-left:.8rem}.artifact:nth-child(3){margin-left:1.6rem}.artifact-index{font-size:.6rem;align-self:start;padding-top:.1rem}.artifact>div{min-width:0}.artifact strong{display:block;font-size:.8rem;font-weight:650;letter-spacing:-.02em}.artifact small{font-size:.45rem;letter-spacing:.1em;font-weight:700}.artifact-end{margin-left:auto;font-size:1rem}.note-bottom{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--color-line);margin-top:1.4rem;padding-top:.8rem;font-size:.6rem;color:var(--color-muted)}
.research-composition{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1.5rem}.focus-item{position:relative}.focus-primary{grid-column:span 6;padding:1.7rem 2rem;background:var(--accent-soft);border-radius:var(--radius);border-top:3px solid var(--accent)}.focus-top{display:flex;justify-content:space-between;color:var(--accent);font-size:.58rem;font-weight:750;letter-spacing:.1em;margin-bottom:1.8rem}.focus-top>span:last-child{font-size:1rem;line-height:1}.focus-item h3{font-size:1.5rem;letter-spacing:-.035em;max-width:22ch}.focus-item h3 a{text-decoration:none}.focus-item h3 a::after{content:'';position:absolute;inset:0}.focus-item:hover h3{color:var(--accent)}.focus-item p{color:var(--color-muted);font-size:.95rem;line-height:1.8;margin-top:.9rem}.focus-item .tags{margin-top:1.3rem}.focus-secondary{grid-column:span 3;border-top:3px solid var(--accent);padding:1.4rem .3rem 0}.focus-secondary h3{font-size:1.1rem}.focus-secondary p{font-size:.9rem}.focus-secondary .focus-top{margin-bottom:1rem}
.event-section{padding-bottom:1rem}.industry-preview{display:grid;grid-template-columns:1fr 1.25fr;gap:5rem}.industry-heading .eyebrow{color:var(--color-muted);margin-bottom:1.3rem}.industry-heading h2 span{color:var(--color-brand)}.industry-heading>p{color:var(--color-muted);font-size:.9rem;margin-block:1.5rem;max-width:43ch}.industry-options{border-top:1px solid var(--color-line)}.industry-options>a{display:flex;gap:1rem;align-items:start;padding:1.3rem 0;border-bottom:1px solid var(--color-line);text-decoration:none}.option-number{font-size:.6rem;color:var(--color-brand);padding-top:.2rem}.industry-options h3{font-size:1.05rem}.industry-options p{font-size:.75rem;color:var(--color-muted);line-height:1.8;margin-top:.4rem}.industry-options>a>span:last-child{margin-left:auto;color:var(--color-brand)}.industry-options a:hover h3{color:var(--color-brand)}.people-preview{background:var(--color-soft);border-top:1px solid var(--color-line)}
@media(max-width:1000px){.hero{gap:2rem}.hero .actions{gap:.6rem}.hero .button{padding:.75rem 1rem}.engineering-note{padding:1.3rem}.artifact{padding:.8rem}.industry-preview{gap:3rem}}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:3rem;gap:2rem}.hero h1{max-width:17ch;font-size:clamp(2.6rem,7.5vw,3.8rem)}.hero-description{max-width:60ch}.engineering-note{max-width:470px;width:100%;margin:.5rem auto}.focus-secondary{grid-column:span 6}.industry-preview{grid-template-columns:1fr}.research-composition{gap:1.5rem}.focus-primary{padding:1.5rem}.focus-item h3{font-size:1.3rem}.focus-secondary h3{font-size:1.1rem}}
@media(max-width:500px){.focus-primary{grid-column:span 12}.focus-secondary p{font-size:.8rem}.hero h1{font-size:2.6rem}.hero-pill{font-size:.56rem}.hero .actions{flex-direction:column;align-items:stretch}.hero .actions .button{justify-content:space-between}.focus-item .focus-top{margin-bottom:1rem}}
</style>
